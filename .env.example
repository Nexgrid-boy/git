# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / CLOUD_RUN_SERVICE_URL: The Cloud Run service URL.
APP_URL="MY_APP_URL"
CLOUD_RUN_SERVICE_URL="https://my-app-url.run.app"

# Google Cloud Platform Configuration
GOOGLE_CLOUD_PROJECT="my-gcp-project"
GOOGLE_CLOUD_REGION="europe-west1"

# Google Cloud Tasks Configuration
CLOUD_TASKS_LOCATION="europe-west1"
CLOUD_TASKS_QUEUE="job-search-queue"

# Service Accounts for Cloud Scheduler & Cloud Tasks OIDC Invocation
SCHEDULER_SERVICE_ACCOUNT_EMAIL="jobpilot-scheduler-sa@my-gcp-project.iam.gserviceaccount.com"
TASKS_SERVICE_ACCOUNT_EMAIL="jobpilot-tasks-sa@my-gcp-project.iam.gserviceaccount.com"
